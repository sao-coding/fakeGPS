<?xml version="1.0" encoding="utf-8"?>
<!-- Static shortcut icons are rendered by the launcher, outside our app's theme — a themed
     tint attr (e.g. ?attr/colorControlNormal) resolves to nothing there, and a plain white glyph
     with no backdrop reads as invisible on a white shortcut badge. This bakes in its own colored
     circle so it's visible regardless of launcher or theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00695C"
        android:pathData="M54,54m-50,0a50,50 0 1,0 100,0a50,50 0 1,0 -100,0" />
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z" />
    </group>
</vector>
